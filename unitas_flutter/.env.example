# URL backend API Unitas (tanpa trailing slash)
BACKEND_URL=https://unitas-beta.vercel.app

# Web OAuth 2.0 Client ID dari Google Cloud Console (dipakai sebagai serverClientId)
# Nilai ini HARUS sama dengan GOOGLE_CLIENT_ID di backend.
GOOGLE_SERVER_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
