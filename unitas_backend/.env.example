# ── Supabase ──────────────────────────────────────────────────────────────
# Dapatkan dari: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── JWT ───────────────────────────────────────────────────────────────────
# Buat string random yang panjang dan unik
JWT_SECRET=ganti_dengan_string_random_yang_panjang_dan_aman
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=ganti_dengan_string_refresh_random_yang_panjang
REFRESH_TOKEN_EXPIRES_IN=30d

# ── App ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────
# Set ke domain Flutter web app atau * untuk semua
CORS_ORIGIN=*
