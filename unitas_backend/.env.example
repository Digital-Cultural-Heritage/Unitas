# ── Supabase ──────────────────────────────────────────────────────────────
# Dapatkan dari: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── JWT ───────────────────────────────────────────────────────────────────
# Buat string random yang panjang dan unik
JWT_SECRET=ganti_dengan_string_random_yang_panjang_dan_aman
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=ganti_dengan_string_refresh_random_yang_panjang
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Google Sign-In ────────────────────────────────────────────────────────
# Web OAuth 2.0 Client ID dari Google Cloud Console (harus sama dengan serverClientId di Flutter)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# Opsional: daftar client ID tambahan dipisah koma jika ada beberapa client/environment
GOOGLE_SERVER_CLIENT_IDS=

# ── Pembatasan Domain Kampus & Email OTP via SMTP (No-Reply) ─────────────
# Penting: saat deploy ke Vercel, salin seluruh variabel SMTP_* / RESEND_API_KEY & EMAIL_FROM
# ke Vercel Dashboard -> Project Settings -> Environment Variables (Production).
ALLOWED_EMAIL_DOMAINS=unud.ac.id,student.unud.ac.id
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Untuk Gmail SMTP, samakan EMAIL_FROM dengan alamat SMTP_USER dan hindari label "No-Reply" agar tidak masuk spam
EMAIL_FROM=Unitas <unitas.unud.noreply@gmail.com>
# Opsional: alamat Reply-To khusus (default mengikuti SMTP_USER)
EMAIL_REPLY_TO=

# ── Keamanan & App ────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────
# Set ke domain Flutter web app (pisahkan koma jika lebih dari satu) atau * untuk semua
CORS_ORIGIN=*
